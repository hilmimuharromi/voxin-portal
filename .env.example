# Database PostgreSQL (boleh server yang sama dengan voxin-engine, database terpisah)
DATABASE_URL=postgres://voxin:voxin@localhost:5432/voxin_portal?sslmode=disable

# Wajib, minimal 16 karakter acak (untuk sesi login)
PORTAL_SECRET_KEY=ganti-dengan-teks-acak-panjang

# Akun pertama (dibuat sekali saat database masih kosong), lalu ganti password dari CMS
PORTAL_ADMIN_EMAIL=pemred@voxin.id
PORTAL_ADMIN_PASSWORD=ganti-password-ini

# Situs publik dan CMS jalan di dua port
PORTAL_PUBLIC_ADDR=:8090
PORTAL_CMS_ADDR=:8091
PORTAL_BASE_URL=http://localhost:8090
PORTAL_CMS_URL=http://localhost:8091

PORTAL_DATA_DIR=./data
TZ=Asia/Jakarta
